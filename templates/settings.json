{
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "WebSearch(*)",
      "WebFetch(*)",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -f *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git filter-branch*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(socat *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(.netrc)",
      "Read(~/.npmrc)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Cookies/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/Library/LaunchDaemons/**)",
      "Edit(/etc/shadow)",
      "Edit(/etc/sudoers)",
      "Edit(/etc/sudoers.d/**)",
      "Edit(/etc/passwd)",
      "Edit(~/.config/systemd/user/**)",
      "Edit(~/.config/autostart/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(pnpm add*)",
      "Bash(yarn add*)",
      "Bash(pip install*)",
      "Bash(brew install*)",
      "Bash(npx -y *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "effortLevel": "high",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/bash-guard.py" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/edit-write-guard.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/audit.py" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/session-start.py" }
        ]
      }
    ]
  }
}
